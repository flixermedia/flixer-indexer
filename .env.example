# Listening port and process role: all | api | worker
PORT=8092
ROLE=all

# flixer (the source of libraries and the place items are saved)
FLIXER_URL=http://localhost:8083
# Shared with flixer and flixer-streamer; signs requests in both directions.
APP_SECRET=change-me

# Redis (the task queue)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Root of all media cache folders
CACHE_PATH=./cache
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# Hover-seek thumbnail sheets (default CACHE_PATH/trickplay; streamer must read this directory)
TRICKPLAY_ENABLED=true
# TRICKPLAY_DIR=./cache/trickplay
TRICKPLAY_INTERVAL=10
TRICKPLAY_WIDTH=320

# Provider keys. flixer's settings take precedence; these are fallbacks.
# MusicBrainz, Cover Art Archive and AniList need no key.
TMDB_API_KEY=
TVDB_API_KEY=
OMDB_API_KEY=
FANART_API_KEY=
AUDIODB_API_KEY=
DISCOGS_TOKEN=
ANIDB_CLIENT=
METADATA_LANGUAGE=en

# Initial workers per queue (flixer can change them at runtime)
# CONCURRENCY_SCAN=2

# Auto-scan libraries when files change (library folders must be mounted in this container)
# WATCH_FOLDERS=true
# WATCH_DEBOUNCE=30s
# Periodic rescan for SMB/NFS shares, which emit no change events (0 = off)
# WATCH_RESCAN_INTERVAL=15m
# CONCURRENCY_IDENTIFY=12
# CONCURRENCY_METADATA=12
# CONCURRENCY_IMAGES=8
# CONCURRENCY_PROBE=12
# CONCURRENCY_REFRESH=4
# CONCURRENCY_TRICKPLAY=6
# CONCURRENCY_THEMES=6

LOG_LEVEL=info

# Run without flixer's indexer endpoints: libraries come from a JSON file and
# items are appended to a JSONL file.
# FLIXER_MODE=stub
# STUB_LIBRARIES_FILE=./libraries.json
# STUB_OUTPUT_FILE=./cache/stub-items.jsonl
